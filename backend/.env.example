# Use Supabase Transaction pooler (port 6543) for the app — NOT session mode (5432).
# Session mode limits you to ~15 connections and causes "max clients reached" errors.
#
# DATABASE_URL=postgresql://USER:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres

DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
GROQ_API_KEYS=key1,key2
GEMINI_API_KEYS=
PEXELS_API_KEY=
