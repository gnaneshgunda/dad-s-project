generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  name           String?
  createdAt      DateTime         @default(now())
  subjects       Subject[]
  history        History[]
  generationJobs GenerationJob[]
  lessonProgress LessonProgress[]
}

model Subject {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  searchQuery     String?
  learningScope   String    @default("quick-lesson")
  isPublic        Boolean   @default(false)
  curriculumJson  String?   @db.Text
  sourceSubjectId Int?
  sourceSubject   Subject?  @relation("SubjectForks", fields: [sourceSubjectId], references: [id])
  forks           Subject[] @relation("SubjectForks")
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([searchQuery, isPublic])
}

model Chapter {
  id               Int             @id @default(autoincrement())
  name             String
  description      String?
  topicQuery       String?
  lessonPlanJson   String?         @db.Text
  generationStatus String          @default("planned")
  sortOrder        Int             @default(0)
  subjectId        Int
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videos           Video[]
  generationJobs   GenerationJob[]
  lessonProgress   LessonProgress[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   Int
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, chapterId])
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  text        String?
  audioUrl    String?
  videoUrl    String?
  quizzesJson String?  @db.Text
  slidesJson  String?  @db.Text
  chapterId   Int
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GenerationJob {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId  Int?
  chapter    Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subjectId  Int?
  type       String
  status     String   @default("pending")
  progress   String?
  resultJson String?  @db.Text
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model History {
  id        Int      @id @default(autoincrement())
  title     String?
  text      String?
  audioUrl  String?
  videoUrl  String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
